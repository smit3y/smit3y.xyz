---
// Every role at once — the blocks they belong to are linked from each entry.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteSections from "../../components/SiteSections.astro";
---

<BaseLayout title="Experience · smit3y.xyz" fullBleed={true}>
  <div class="xp-bar">
    <a class="xp-back" href="/" data-nav-home><span aria-hidden="true">←</span> Back to the city</a>
    <p class="xp-note">Towers #1 · #3 · #4 — open a role to step inside its building.</p>
  </div>
  <SiteSections only={["experience"]} blockLinks />
</BaseLayout>

<style>
  .xp-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    width: min(100% - 2 * max(16px, env(safe-area-inset-left, 0px)), 72rem);
    margin: 0 auto;
    padding-top: 1.25rem;
  }

  .xp-back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border-6));
    border-radius: 999px;
    color: var(--text-heading);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .xp-back:hover,
  .xp-back:focus-visible {
    border-color: var(--accent);
    outline: none;
  }

  .xp-note {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.82rem;
  }
</style>
