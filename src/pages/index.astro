---
// The hub: Neon Harbor. The city is the persistent world (NeonWorld) that
// every block page flies into; this page lays the hero and labels over it.
import BaseLayout from "../layouts/BaseLayout.astro";
import CityHub from "../components/CityHub.astro";
---

<BaseLayout title="smit3y.xyz" fullBleed={true} world worldMode="neon">
  <CityHub mode="neon" />
  <script is:inline>
    // links to the old one-page site's sections (/#research …) open their pages
    (function () {
      var to = { "#about": "/about", "#experience": "/experience", "#research": "/research", "#sny": "/sny" }[location.hash];
      if (to) location.replace(to);
    })();
  </script>
</BaseLayout>
