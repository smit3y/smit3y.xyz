---
import { Image } from "astro:assets";
import headshot from "../assets/smit3y.jpg";
import bass from "../assets/about-bass.jpg";
import coastal from "../assets/about-coastal.jpg";
import snowAngels from "../assets/about-snowangels.jpg";
import overlook from "../assets/about-overlook.jpg";
import chalk from "../assets/about-chalk.jpg";
import hiking from "../assets/about-hiking.jpg";

// Collage: photos scattered and overlapping at varied sizes/rotations,
// each positioned as a % of the collage box (top/left/width) plus a resting
// rotation and stacking order. Values are hand-tuned, not derived from data.
// Headshot uses top: 0 and a width % (both independent of container height),
// so it stays put whenever the container grows taller to fit more tiles.
const photos = [
  { src: headshot, alt: "Eli Robinson", top: 0, left: 2, width: 52, rotate: -3, z: 3 },
  { src: bass, alt: "Eli playing bass", top: 3, left: 46, width: 48, rotate: 6, z: 2 },
  { src: coastal, alt: "Eli on the California coast", top: 24, left: 0, width: 44, rotate: 4, z: 4 },
  { src: snowAngels, alt: "Eli making snow angels", top: 32, left: 40, width: 50, rotate: -6, z: 2 },
  { src: overlook, alt: "Eli at a snowy overlook", top: 54, left: 6, width: 42, rotate: 5, z: 5 },
  { src: chalk, alt: "Eli in front of Sam Smith sidewalk chalk art", top: 60, left: 44, width: 46, rotate: -4, z: 2 },
  { src: hiking, alt: "Eli backpacking through a creek crossing", top: 78, left: 20, width: 44, rotate: 3, z: 6 },
];
---

<div class="about-photos">
  {
    photos.map((photo) => (
      <div
        class="about-photos__item"
        style={{
          "--top": `${photo.top}%`,
          "--left": `${photo.left}%`,
          "--w": `${photo.width}%`,
          "--rot": `${photo.rotate}deg`,
          "--z": photo.z,
        }}
      >
        <Image
          class="about-photos__img"
          src={photo.src}
          alt={photo.alt}
          widths={[280, 560]}
          sizes="(max-width: 760px) 50vw, 18rem"
          loading="lazy"
        />
      </div>
    ))
  }
</div>

<style>
  /* Scattered, overlapping collage — varied sizes/rotations, each
     tile positioned via --top/--left/--w/--rot/--z set inline per photo. */
  .about-photos {
    position: relative;
    width: clamp(26rem, 42vw, 34rem);
    aspect-ratio: 5 / 10.5;
  }

  .about-photos__item {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: calc(var(--w) * var(--tile-scale, 1));
    aspect-ratio: 1;
    z-index: var(--z);
    overflow: hidden;
    border: 1px solid var(--border-3);
    border-radius: 10px;
    background: var(--bg-img);
    box-shadow:
      var(--shadow-tag),
      0 0 0 1px var(--border-img);
    transform: rotate(var(--rot));
    transform-origin: center;
    transition:
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease,
      border-color 280ms ease;
  }

  .about-photos__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-photos__item:hover {
    z-index: 10;
    border-color: var(--border-tag-hover);
    transform: rotate(calc(var(--rot) * 0.25)) scale(1.1);
  }

  @media (hover: none) {
    .about-photos__item:hover {
      transform: rotate(var(--rot));
    }
  }

  /* Mobile: same collage scaled to the column width, but squashed shorter
     with slightly larger tiles so the photos overlap more and it doesn't fill
     a whole phone screen. The bottom tile hangs past the shorter box, so the
     margin keeps it clear of the text below. */
  @media (max-width: 760px) {
    .about-photos {
      --tile-scale: 1.12;
      order: 1;
      width: 100%;
      max-width: 24rem;
      aspect-ratio: 5 / 8.4;
      margin-bottom: 12%;
      justify-self: center;
    }
  }
</style>
