---
import { fallbackItems } from "../lib/ticker/fallback";
const tickerItems = fallbackItems;

// Each nav item is a block (or group of blocks) on the chain.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { label: "Home", href: "/", match: (p: string) => p === "/" },
  { label: "About", href: "/about/", match: (p: string) => p === "/about" },
  { label: "Research", href: "/research/", match: (p: string) => p.startsWith("/research") },
  { label: "Experience", href: "/experience/", match: (p: string) => p.startsWith("/experience") },
  { label: "S&Y", href: "/sny/", match: (p: string) => p === "/sny" },
];
const isClassic = path === "/classic";
---

<div class="site-chrome" transition:persist="site-chrome">
  <header class="site-header" aria-label="Site header">
    <a class="brand-mark" href="/" data-nav-home aria-label="smit3y.xyz home">
      <span class="brand-icon" aria-hidden="true">S3</span>
      <span>smit3y.xyz</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            class:list={["magnetic", item.match(path) && "is-active"]}
            href={item.href}
            data-nav-home={item.href === "/" ? "" : undefined}
            aria-current={item.match(path) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="nav-controls">
        <button class="theme-toggle" type="button" aria-label="Toggle light/dark theme">
          <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <div class="palette-menu">
          <button class="palette-toggle" type="button" aria-label="Choose color theme" aria-expanded="false" aria-haspopup="menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
            </svg>
          </button>
          <div class="palette-popover" role="menu" aria-label="Color themes" hidden>
            <button class="palette-option" type="button" role="menuitemradio" data-palette-choice="midnight" aria-checked="false">
              <span class="palette-swatch palette-swatch-midnight" aria-hidden="true"></span>
              <span class="palette-option-name">Midnight</span>
              <svg class="palette-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <button class="palette-option" type="button" role="menuitemradio" data-palette-choice="solar" aria-checked="true">
              <span class="palette-swatch palette-swatch-solar" aria-hidden="true"></span>
              <span class="palette-option-name">Solar</span>
              <svg class="palette-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <button class="palette-option" type="button" role="menuitemradio" data-palette-choice="forest" aria-checked="false">
              <span class="palette-swatch palette-swatch-forest" aria-hidden="true"></span>
              <span class="palette-option-name">Forest</span>
              <svg class="palette-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <button class="palette-option" type="button" role="menuitemradio" data-palette-choice="crimson" aria-checked="false">
              <span class="palette-swatch palette-swatch-crimson" aria-hidden="true"></span>
              <span class="palette-option-name">Crimson</span>
              <svg class="palette-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <button class="palette-option" type="button" role="menuitemradio" data-palette-choice="mono" aria-checked="false">
              <span class="palette-swatch palette-swatch-mono" aria-hidden="true"></span>
              <span class="palette-option-name">Mono</span>
              <svg class="palette-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <div class="palette-divider" role="separator"></div>
            <button class="palette-option" type="button" role="menuitemradio" data-palette-choice="custom" aria-checked="false">
              <span class="palette-swatch palette-swatch-custom" aria-hidden="true"></span>
              <span class="palette-option-name">Custom</span>
              <svg class="palette-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <div class="palette-custom-panel" hidden>
              <label><span>Accent</span><input type="color" data-custom-var="accent" value="#8b5cf6"/></label>
              <label><span>G1</span><input type="color" data-custom-var="g1" value="#8791ff"/></label>
              <label><span>G2</span><input type="color" data-custom-var="g2" value="#5ea1f2"/></label>
              <label><span>G3</span><input type="color" data-custom-var="g3" value="#17bfd1"/></label>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </header>
  <div class="market-ticker" aria-label="Market ticker">
    <div class="market-ticker-track">
      {
        [...tickerItems, ...tickerItems].map((item) => (
          <span class="market-ticker-item" data-symbol={item.symbol}>
            <span class="market-symbol">{item.symbol}</span>
            <span class="market-price">{item.price}</span>
            <span class:list={["market-change", item.isNegative && "is-negative"]}>
              {item.change}
            </span>
          </span>
        ))
      }
    </div>
  </div>
</div>
{
  isClassic && (
    <nav class="section-dots" aria-label="Section progress">
      <a class="is-active" href="#home" aria-label="Home" aria-current="page"></a>
      <a href="#about" aria-label="About"></a>
      <a href="#research" aria-label="Research"></a>
      <a href="#experience" aria-label="Experience"></a>
      <a href="#sny" aria-label="S and Y"></a>
    </nav>
  )
}

<script>
  // The nav is persisted across client-side navigation, so its own
  // listeners are bound once; page-dependent bits re-run on every page.
  const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const html = document.documentElement;
    const isLight = html.getAttribute("data-theme") === "light";
    const next = isLight ? "dark" : "light";
    if (next === "dark") {
      html.removeAttribute("data-theme");
    } else {
      html.setAttribute("data-theme", next);
    }
    localStorage.setItem("theme", next);
  });

  const matchers: Array<[string, (p: string) => boolean]> = [
    ["/", (p) => p === "/"],
    ["/about/", (p) => p === "/about"],
    ["/research/", (p) => p.startsWith("/research")],
    ["/experience/", (p) => p.startsWith("/experience")],
    ["/sny/", (p) => p === "/sny"],
  ];

  let pageAbort: AbortController | null = null;

  document.addEventListener("astro:page-load", () => {
    pageAbort?.abort();
    pageAbort = new AbortController();
    const { signal } = pageAbort;

    // "home" is whichever hub this visit uses (3D chain, pixel or neon city)
    const mode = document.documentElement.dataset.worldMode;
    const hub = mode === "pixel" ? "/city/" : "/";
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-home]").forEach((a) => a.setAttribute("href", hub));

    // active nav item for the current page
    const path = location.pathname.replace(/\/$/, "") || "/";
    for (const link of document.querySelectorAll<HTMLAnchorElement>(".site-nav a")) {
      const m = matchers.find(([href]) => href === link.getAttribute("href"));
      const active = link.hasAttribute("data-nav-home") ? path === (hub.replace(/\/$/, "") || "/") : !!m && m[1](path);
      link.classList.toggle("is-active", active);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }

    // section dots (classic page only) track scroll position
    const dotLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".section-dots a"));
    if (!dotLinks.length) return;
    const setActiveSection = (id: string) => {
      for (const link of dotLinks) {
        const isActive = link.hash === `#${id}`;
        link.classList.toggle("is-active", isActive);
        if (isActive) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
    };
    for (const link of dotLinks) {
      link.addEventListener("click", () => {
        const id = link.hash.slice(1);
        if (id) setActiveSection(id);
      }, { signal });
    }
    const sectionTargets = dotLinks
      .filter((link) => link.hash.length > 1)
      .map((link) => document.querySelector<HTMLElement>(link.hash))
      .filter((section): section is HTMLElement => section !== null);
    const update = () => {
      if (!sectionTargets.length) return;
      const marker = window.innerHeight * 0.42;
      let active = sectionTargets[0];
      for (let i = sectionTargets.length - 1; i >= 0; i -= 1) {
        if (sectionTargets[i].getBoundingClientRect().top <= marker) {
          active = sectionTargets[i];
          break;
        }
      }
      setActiveSection(active.id);
    };
    let frame = 0;
    window.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    }, { passive: true, signal });
    window.addEventListener("resize", update, { signal });
    update();
  });
</script>

<script>
  interface TickerItem {
    symbol: string;
    price: string;
    change: string;
    isNegative: boolean;
  }

  async function refreshTicker() {
    try {
      const res = await fetch("/api/ticker");
      if (!res.ok) return;
      const { data: items }: { data: TickerItem[] } = await res.json();

      const allItems = document.querySelectorAll<HTMLSpanElement>(
        ".market-ticker-item",
      );
      const count = items.length;

      for (let i = 0; i < allItems.length; i++) {
        const item = items[i % count];
        const el = allItems[i];
        const priceEl = el.querySelector<HTMLSpanElement>(".market-price");
        const changeEl = el.querySelector<HTMLSpanElement>(".market-change");

        if (priceEl) priceEl.textContent = item.price;
        if (changeEl) {
          changeEl.textContent = item.change;
          changeEl.classList.toggle("is-negative", item.isNegative);
        }
      }
    } catch {
      // silently keep fallback data
    }
  }

  refreshTicker();
</script>

<script>
  const PALETTES = ["midnight", "solar", "forest", "crimson", "mono"] as const;
  type Palette = (typeof PALETTES)[number] | "custom";
  type CustomColors = { accent: string; g1: string; g2: string; g3: string };

  const root = document.documentElement;
  const CUSTOM_VARS = [
    "--accent",
    "--accent-light",
    "--accent-lighter",
    "--accent-blue",
    "--g1",
    "--g2",
    "--g3",
    "--gradient-hero",
    "--gradient-timeline",
    "--glow-1",
    "--glow-2",
    "--glow-3",
    "--glow-4",
    "--glow-5",
    "--glow-6",
    "--glow-7",
    "--border-img",
    "--shadow-tag",
    "--text-nav-hover",
    "--text-hover-tag",
    "--c-accent",
    "--c-g1",
    "--c-g2",
    "--c-g3",
  ];

  function applyPaletteAttribute(name: Palette) {
    if (name === "midnight") {
      root.removeAttribute("data-palette");
    } else {
      root.setAttribute("data-palette", name);
    }
  }

  function clearCustomInlineStyles() {
    for (const v of CUSTOM_VARS) root.style.removeProperty(v);
  }

  function applyCustomColors(colors: CustomColors) {
    const s = root.style;
    s.setProperty("--c-accent", colors.accent);
    s.setProperty("--c-g1", colors.g1);
    s.setProperty("--c-g2", colors.g2);
    s.setProperty("--c-g3", colors.g3);
  }

  function readCustom(): CustomColors {
    try {
      const raw = localStorage.getItem("custom-palette");
      if (!raw) throw new Error("no custom palette");
      const parsed = JSON.parse(raw) as Partial<CustomColors>;
      if (!parsed.accent || !parsed.g1 || !parsed.g2 || !parsed.g3) {
        throw new Error("incomplete");
      }
      return {
        accent: parsed.accent,
        g1: parsed.g1,
        g2: parsed.g2,
        g3: parsed.g3,
      };
    } catch {
      return { accent: "#8b5cf6", g1: "#8791ff", g2: "#5ea1f2", g3: "#17bfd1" };
    }
  }

  const paletteToggle = document.querySelector<HTMLButtonElement>(".palette-toggle");
  const palettePopover = document.querySelector<HTMLDivElement>(".palette-popover");
  const paletteOptions = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-palette-choice]"),
  );
  const customPanel = document.querySelector<HTMLDivElement>(".palette-custom-panel");
  const customInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>(".palette-custom-panel input[type='color']"),
  );

  function openPopover() {
    if (!palettePopover || !paletteToggle) return;
    palettePopover.hidden = false;
    requestAnimationFrame(() => {
      palettePopover.classList.add("is-open");
    });
    paletteToggle.setAttribute("aria-expanded", "true");
  }

  function closePopover() {
    if (!palettePopover || !paletteToggle) return;
    palettePopover.classList.remove("is-open");
    paletteToggle.setAttribute("aria-expanded", "false");
    const handle = (e: TransitionEvent) => {
      if (e.propertyName !== "opacity") return;
      palettePopover.hidden = true;
      palettePopover.removeEventListener("transitionend", handle);
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      palettePopover.hidden = true;
    } else {
      palettePopover.addEventListener("transitionend", handle);
    }
  }

  function syncChecked(name: Palette) {
    for (const btn of paletteOptions) {
      const choice = btn.dataset.paletteChoice as Palette;
      btn.setAttribute("aria-checked", choice === name ? "true" : "false");
    }
    if (customPanel) customPanel.hidden = name !== "custom";
  }

  function syncCustomInputs(colors: CustomColors) {
    for (const input of customInputs) {
      const key = input.dataset.customVar as keyof CustomColors | undefined;
      if (key && colors[key]) input.value = colors[key];
    }
  }

  function selectPalette(name: Palette) {
    clearCustomInlineStyles();
    if (name === "custom") {
      const colors = readCustom();
      applyPaletteAttribute("custom");
      applyCustomColors(colors);
      localStorage.setItem("palette", "custom");
      localStorage.setItem("custom-palette", JSON.stringify(colors));
      syncCustomInputs(colors);
    } else {
      applyPaletteAttribute(name);
      localStorage.setItem("palette", name);
    }
    syncChecked(name);
  }

  paletteToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const expanded = paletteToggle.getAttribute("aria-expanded") === "true";
    if (expanded) closePopover();
    else openPopover();
  });

  paletteToggle?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      openPopover();
      const first = paletteOptions[0];
      first?.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (!palettePopover || !palettePopover.classList.contains("is-open")) return;
    if (
      !palettePopover.contains(e.target as Node) &&
      e.target !== paletteToggle &&
      !paletteToggle?.contains(e.target as Node)
    ) {
      closePopover();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (!palettePopover || !palettePopover.classList.contains("is-open")) return;
    e.preventDefault();
    closePopover();
    paletteToggle?.focus();
  });

  for (const btn of paletteOptions) {
    btn.addEventListener("click", () => {
      const choice = btn.dataset.paletteChoice as Palette | undefined;
      if (!choice) return;
      selectPalette(choice);
    });
    btn.addEventListener("keydown", (e) => {
      const idx = paletteOptions.indexOf(btn);
      if (e.key === "ArrowDown") {
        e.preventDefault();
        paletteOptions[(idx + 1) % paletteOptions.length]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        paletteOptions[(idx - 1 + paletteOptions.length) % paletteOptions.length]?.focus();
      } else if (e.key === "Home") {
        e.preventDefault();
        paletteOptions[0]?.focus();
      } else if (e.key === "End") {
        e.preventDefault();
        paletteOptions[paletteOptions.length - 1]?.focus();
      }
    });
  }

  for (const input of customInputs) {
    input.addEventListener("input", () => {
      const key = input.dataset.customVar as keyof CustomColors | undefined;
      if (!key) return;
      const colors = readCustom();
      colors[key] = input.value;
      localStorage.setItem("custom-palette", JSON.stringify(colors));
      applyCustomColors(colors);
    });
  }

  // Initial UI sync (the palette attribute + inline styles are already
  // applied by the no-flash script in BaseLayout.astro).
  const initialPalette = (localStorage.getItem("palette") || "solar") as Palette;
  syncChecked(initialPalette);
  if (initialPalette === "custom") syncCustomInputs(readCustom());
</script>

<script>
  import { wrapLetters, scrambleOnHover } from "../lib/scramble";

  // Magnetic hover: nudges any .magnetic element toward the cursor within
  // its bounds, eased back to rest on leave. Site-wide (nav links, hero
  // buttons, etc. all just need the .magnetic class).
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Scramble/decode on hover for the primary nav links.
  if (!reduceMotion.matches) {
    const navLinks = Array.from(document.querySelectorAll<HTMLElement>(".site-nav a"));
    for (const link of navLinks) {
      const letters = wrapLetters(link);
      scrambleOnHover(link, letters);
    }
  }

  const bindMagnetic = () => {
    if (reduceMotion.matches) return;
    const magneticEls = Array.from(document.querySelectorAll<HTMLElement>(".magnetic:not([data-mag-bound])"));

    for (const el of magneticEls) {
      el.dataset.magBound = "";
      // Small elements (nav links, buttons) want a strong, snappy pull;
      // large ones (the hero title) need a much gentler one or the offset
      // gets huge near the edges. Override per-element via data attrs.
      const strength = parseFloat(el.dataset.magneticStrength ?? "0.35");
      const maxOffset = parseFloat(el.dataset.magneticMax ?? "24");

      el.addEventListener("mousemove", (e) => {
        const rect = el.getBoundingClientRect();
        const rawX = (e.clientX - rect.left - rect.width / 2) * strength;
        const rawY = (e.clientY - rect.top - rect.height / 2) * strength;
        const mx = Math.max(-maxOffset, Math.min(maxOffset, rawX));
        const my = Math.max(-maxOffset, Math.min(maxOffset, rawY));
        el.style.setProperty("--mx", `${mx}px`);
        el.style.setProperty("--my", `${my}px`);
      });

      el.addEventListener("mouseleave", () => {
        el.style.setProperty("--mx", "0px");
        el.style.setProperty("--my", "0px");
      });
    }
  };

  // Glow card: tracks the cursor across .glow-card elements and exposes
  // the position as --gx/--gy percentages for a radial-gradient in CSS.
  const bindGlowCards = () => {
  const glowCards = Array.from(document.querySelectorAll<HTMLElement>(".glow-card:not([data-glow-bound])"));

  for (const card of glowCards) {
    card.dataset.glowBound = "";
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const gx = ((e.clientX - rect.left) / rect.width) * 100;
      const gy = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty("--gx", `${gx}%`);
      card.style.setProperty("--gy", `${gy}%`);
    });
  }
  };

  document.addEventListener("astro:page-load", () => {
    bindMagnetic();
    bindGlowCards();
  });

  // Cursor trail: a fading comet streak drawn on <canvas>, following the
  // mouse across the whole site. Skipped on touch devices (no real mouse)
  // and when the user prefers reduced motion.
  const canFinePointer = window.matchMedia("(pointer: fine)").matches;
  const trailCanvas = document.querySelector<HTMLCanvasElement>(".cursor-trail");

  if (trailCanvas && canFinePointer && !reduceMotion.matches) {
    const ctx = trailCanvas.getContext("2d");

    if (ctx) {
      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        trailCanvas.width = window.innerWidth * dpr;
        trailCanvas.height = window.innerHeight * dpr;
        trailCanvas.style.width = `${window.innerWidth}px`;
        trailCanvas.style.height = `${window.innerHeight}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener("resize", resize);

      type Point = { x: number; y: number; t: number };
      let points: Point[] = [];
      let rafId = 0;
      const maxAge = 380;
      const ease = 0.3;

      // The trail follows an eased "chase" point rather than the raw
      // cursor, so it glides and lags slightly instead of snapping to
      // each mousemove sample — this is what makes it feel fluid.
      let targetX = 0;
      let targetY = 0;
      let curX = 0;
      let curY = 0;
      let hasTarget = false;

      const accentColor = () =>
        getComputedStyle(document.documentElement).getPropertyValue("--accent-light").trim() ||
        "#a78bfa";

      const draw = (now: number) => {
        curX += (targetX - curX) * ease;
        curY += (targetY - curY) * ease;
        points.push({ x: curX, y: curY, t: now });
        points = points.filter((p) => now - p.t < maxAge);
        ctx.clearRect(0, 0, trailCanvas.width, trailCanvas.height);

        if (points.length > 2) {
          const color = accentColor();
          ctx.lineCap = "round";
          ctx.shadowColor = color;
          ctx.shadowBlur = 8;
          ctx.strokeStyle = color;

          // Midpoint smoothing: each segment is a quadratic curve through
          // the midpoints of its neighbors, so the path bends smoothly
          // through every sample instead of kinking at each point.
          for (let i = 1; i < points.length - 1; i += 1) {
            const p0 = points[i - 1];
            const p1 = points[i];
            const p2 = points[i + 1];
            const midA = { x: (p0.x + p1.x) / 2, y: (p0.y + p1.y) / 2 };
            const midB = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
            const age = (now - p1.t) / maxAge;
            const alpha = Math.max(0, 1 - age);
            ctx.globalAlpha = alpha * 0.85;
            ctx.lineWidth = Math.max(0.5, 6 * (1 - age));
            ctx.beginPath();
            ctx.moveTo(midA.x, midA.y);
            ctx.quadraticCurveTo(p1.x, p1.y, midB.x, midB.y);
            ctx.stroke();
          }
          ctx.globalAlpha = 1;
        }

        const stillChasing = Math.hypot(targetX - curX, targetY - curY) > 0.4;
        rafId = points.length > 0 || stillChasing ? requestAnimationFrame(draw) : 0;
      };

      window.addEventListener(
        "mousemove",
        (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
          if (!hasTarget) {
            curX = targetX;
            curY = targetY;
            hasTarget = true;
          }
          if (!rafId) rafId = requestAnimationFrame(draw);
        },
        { passive: true },
      );

      reduceMotion.addEventListener("change", () => {
        if (!reduceMotion.matches) return;
        cancelAnimationFrame(rafId);
        rafId = 0;
        points = [];
        ctx.clearRect(0, 0, trailCanvas.width, trailCanvas.height);
      });
    }
  }

  // Scroll progress bar: native CSS scroll-timeline drives this in
  // Chrome/Edge (see .scroll-progress in global.css). Everywhere else,
  // fall back to a scroll-position calculation setting the same
  // --scroll-progress custom property the CSS reads for its transform.
  const supportsScrollTimeline =
    "CSS" in window && CSS.supports("animation-timeline: scroll()");

  if (!supportsScrollTimeline) {
    const progressEl = document.querySelector<HTMLElement>(".scroll-progress");
    if (progressEl) {
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
        progressEl.style.setProperty("--scroll-progress", String(Math.min(1, Math.max(0, progress))));
      };
      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress);
    }
  }
</script>
