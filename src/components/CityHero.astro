---
// The original smit3y.xyz hero (whoami + gradient title + socials), shared
// by the 2D city drafts. Position it from the parent with `class`.
interface Props {
  class?: string;
  sub?: string;
  cue?: string;
}
const { class: cls, sub = "Coinbase · University of Michigan · S&Y Scholars", cue } = Astro.props;
---

<div class:list={["ch", cls]} data-city-hero>
  <p class="ch-type" aria-hidden="true" data-typewriter="&gt; whoami"></p>
  <h1 class="ch-title">SMIT3Y.XYZ</h1>
  <p class="ch-sub">{sub}</p>
  <ul class="ch-socials" aria-label="Socials">
    <li>
      <a class="ch-social" href="https://www.linkedin.com/in/ssam-smith/" target="_blank" rel="noopener noreferrer me">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 7c1.12 0 1.87-.75 1.87-1.75C7.12 4.25 6.37 3.5 5.25 3.5 4.13 3.5 3.38 4.25 3.38 5.25 3.38 6.25 4.13 7 5.25 7ZM20.44 20h-3.38v-6.13c0-1.5-.53-2.5-1.87-2.5-1.02 0-1.63.69-1.9 1.35-.1.24-.12.58-.12.92V20h-3.38s.05-10.44 0-11.5h3.38v1.63c.45-.7 1.25-1.7 3.04-1.7 2.22 0 3.88 1.45 3.88 4.56V20Z"></path></svg>
        LinkedIn
      </a>
    </li>
    <li>
      <a class="ch-social" href="https://x.com/smit3y_" target="_blank" rel="noopener noreferrer me">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.6 10.6 20.4 3h-1.9l-5.6 6.6L8.3 3H3l7.1 10.1L3 21h1.9l6-7 5.1 7H21l-7.4-10.4Zm-2.1 2.5-.7-1L5.3 4.4h2.1l4.4 6.3.7 1 5.8 8.2h-2.1l-4.7-6.7Z"></path></svg>
        X
      </a>
    </li>
    <li>
      <button class="ch-social" type="button" data-copy-email="ssamsmit@umich.edu" aria-label="Copy ssamsmit@umich.edu to clipboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
        <span data-email-label>Email</span>
      </button>
    </li>
  </ul>
  {cue && <p class="ch-cue">{cue}</p>}
</div>

<style>
  .ch {
    display: grid;
    justify-items: start;
    gap: 0.55rem;
    max-width: calc(100vw - 32px);
  }

  .ch p,
  .ch h1 {
    margin: 0;
  }

  .ch-type {
    min-height: 1.4em;
    color: var(--accent-light);
    font: 700 clamp(0.95rem, 1.6vw, 1.1rem) / 1.3 Inconsolata, monospace;
    letter-spacing: 0.12em;
  }

  .ch-type.is-typing::after,
  .ch-type.is-done::after {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.15em;
    background: currentColor;
    content: "";
    vertical-align: -0.15em;
    animation: ch-caret 1s steps(1) infinite;
  }

  @keyframes ch-caret {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .ch-title {
    padding-bottom: 0.06em;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font: 900 clamp(2.4rem, min(6.4vw, 10.5svh), 5.4rem) / 0.95 Inconsolata, monospace;
    white-space: nowrap;
  }

  .ch-sub {
    color: var(--text-lead);
    font: 600 clamp(0.95rem, 1.4vw, 1.08rem) / 1.4 Inconsolata, monospace;
    letter-spacing: 0.02em;
  }

  .ch-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ch-social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.8rem;
    border: 1px solid var(--border-6);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-0) 86%, transparent);
    color: var(--text-heading);
    cursor: pointer;
    font: 700 0.8rem/1 Inconsolata, monospace;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .ch-social svg {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--accent-light);
  }

  .ch-social:hover,
  .ch-social:focus-visible {
    border-color: var(--accent);
    color: var(--text-bright);
    outline: none;
  }

  .ch-cue {
    margin-top: 0.5rem !important;
    color: var(--text-sub);
    font: 700 0.75rem/1 Inconsolata, monospace;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .ch {
      gap: 0.4rem;
    }

    .ch-socials {
      margin-top: 0.1rem;
    }

    .ch-cue {
      margin-top: 0.2rem !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-type::after {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    for (const hero of document.querySelectorAll<HTMLElement>("[data-city-hero]")) {
      if (hero.dataset.bound) continue;
      hero.dataset.bound = "1";
      const btn = hero.querySelector<HTMLButtonElement>("[data-copy-email]");
      const label = hero.querySelector<HTMLElement>("[data-email-label]");
      btn?.addEventListener("click", async () => {
        let msg = "Copied";
        try {
          await navigator.clipboard.writeText(btn.dataset.copyEmail ?? "");
        } catch {
          msg = btn.dataset.copyEmail ?? "Copy failed";
        }
        if (label) {
          label.textContent = msg;
          setTimeout(() => (label.textContent = "Email"), 1800);
        }
      });
      const tw = hero.querySelector<HTMLElement>("[data-typewriter]");
      if (!tw) continue;
      const full = tw.dataset.typewriter ?? "";
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        tw.textContent = full;
        tw.classList.add("is-done");
        continue;
      }
      tw.classList.add("is-typing");
      let i = 0;
      const step = () => {
        i += 1;
        tw.textContent = full.slice(0, i);
        if (i < full.length) setTimeout(step, 34);
        else tw.classList.replace("is-typing", "is-done");
      };
      setTimeout(step, 260);
    }
  });
</script>
